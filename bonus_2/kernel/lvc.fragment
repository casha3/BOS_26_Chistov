# =====================================================================
#  Фрагмент конфигурации ядра по рекомендациям ИСП РАН
#  https://portal.linuxtesting.ru/LVCFuzzingKernelOptions.html
#  ("Добавление отладочных опций")
#
#  Это перенос списка ./scripts/config из методики в формат фрагмента
#  .config.  Значения "n" записаны как "# ... is not set".
#
#  ВАЖНО: часть опций методики отсутствует в современных ядрах (7.x).
#  Они отмечены комментариями ниже, чтобы не создавать иллюзию применения.
#  Сверено с lib/Kconfig.debug, lib/Kconfig.ubsan и т.п. ядра 7.3.6.
# =====================================================================

# --- Детекторы и отладка ---------------------------------------------
CONFIG_KASAN=y
CONFIG_KASAN_INLINE=y
CONFIG_KCOV=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_KCOV_INSTRUMENT_ALL=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAULT_INJECTION_USERCOPY=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAIL_MAKE_REQUEST=y
CONFIG_FAIL_IO_TIMEOUT=y
CONFIG_FAIL_FUTEX=y

# --- Lockdep / атомарный контекст ------------------------------------
CONFIG_LOCKDEP=y
CONFIG_LOCKDEP_BITS=17
CONFIG_LOCKDEP_CHAINS_BITS=18
CONFIG_LOCKDEP_STACK_TRACE_BITS=20
CONFIG_LOCKDEP_STACK_TRACE_HASH_BITS=14
CONFIG_LOCKDEP_CIRCULAR_QUEUE_BITS=12
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_PROVE_RCU=y

# --- Прочее усиление проверок ----------------------------------------
CONFIG_DEBUG_VM=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WQ_WATCHDOG=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=140
CONFIG_RCU_CPU_STALL_TIMEOUT=100
CONFIG_DEBUG_KMEMLEAK=y
# CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN is not set
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000

# --- Отладочная информация -------------------------------------------
CONFIG_DEBUG_INFO=y
CONFIG_GDB_SCRIPTS=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_UNWINDER_ORC=y
# CONFIG_RANDOMIZE_BASE is not set
# В 7.x это choice; «не сжимать» = DEBUG_INFO_COMPRESSED_NONE.
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_PVH=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# --- Командная строка ядра (как в методике) ---------------------------
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="earlyprintk=serial net.ifnames=0 sysctl.kernel.hung_task_all_cpu_backtrace=1 ima_policy=tcb nf-conntrack-ftp.ports=20000 nf-conntrack-tftp.ports=20000 nf-conntrack-sip.ports=20000 nf-conntrack-irc.ports=20000 nf-conntrack-sane.ports=20000 binder.debug_mask=0 rcupdate.rcu_expedited=1 no_hash_pointers page_owner=on sysctl.vm.nr_hugepages=4 sysctl.vm.nr_overcommit_hugepages=4 secretmem.enable=1 msr.allow_writes=off root=/dev/sda console=ttyS0 vsyscall=native numa=fake=2 kvm-intel.nested=1 spec_store_bypass_disable=prctl nopcid vivid.n_devs=16 vivid.multiplanar=1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2 netrom.nr_ndevs=16 rose.rose_ndevs=16 dummy_hcd.num=8 smp.csd_lock_timeout=100000 watchdog_thresh=55 workqueue.watchdog_thresh=140 sysctl.net.core.netdev_unregister_timeout_secs=140 panic_on_warn=1"
# CONFIG_CMDLINE_OVERRIDE is not set

# --- Виртуальные устройства, которые фаззят через syzkaller -----------
CONFIG_TUN=y
CONFIG_MAC80211_HWSIM=y
# CONFIG_IEEE802154_FAKELB is not set
CONFIG_IEEE802154_HWSIM=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_RAW_GADGET=y
CONFIG_BT_HCIVHCI=y

# --- UBSAN (в объёме методики) ---------------------------------------
CONFIG_UBSAN=y
# UBSAN_SANITIZE_ALL: удалён; в 7.x проверки включаются потиповыми опциями.
# CONFIG_UBSAN_TRAP is not set
# UBSAN_MISC: удалён из ядра.
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
# CONFIG_UBSAN_DIV_ZERO is not set
# CONFIG_UBSAN_BOOL is not set
# UBSAN_OBJECT_SIZE: удалён из ядра.
# UBSAN_SIGNED_OVERFLOW / UBSAN_UNSIGNED_OVERFLOW: заменены на
# UBSAN_INTEGER_WRAP, который depends on BROKEN и в фаззинг-ядре недоступен.
# CONFIG_UBSAN_ENUM is not set
# CONFIG_UBSAN_ALIGNMENT is not set

# --- Отключение нежелательных интерфейсов -----------------------------
# CONFIG_DEVMEM is not set
# DEVKMEM: опция удалена из ядра (начиная с 5.13 её не существует).
# CONFIG_DEVPORT is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_MODULE_FORCE_UNLOAD is not set
CONFIG_SECURITY_TOMOYO_INSECURE_BUILTIN_SETTING=y

# --- Для Debian-подобного rootfs (create-image.sh) --------------------
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y
