# =====================================================================
#  Фрагмент конфигурации: цель фаззинга mlx4 + минимальный гость
# =====================================================================

# --- PCI и MSI --------------------------------------------------------
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# --- Mellanox mlx4 (встроено в ядро, без initramfs) -------------------
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX4_CORE=y
CONFIG_MLX4_EN=y
# CONFIG_MLX4_INFINIBAND is not set
# CONFIG_MLX4_DEBUG is not set

# --- Сетевой стек, нужный syzkaller ----------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_INET6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NET_DEVLINK=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SWITCHDEV=y

# --- Гостевое железо: диск /dev/sda (IDE) и NIC syzkaller (e1000) -----
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI=y
CONFIG_E1000=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# --- rootfs и systemd -------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_EFI=y
CONFIG_ACPI=y
CONFIG_ACPI_HOTPLUG_CPU=y

# --- Отключаем лишнее, что даёт «мусорные» падения --------------------
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
