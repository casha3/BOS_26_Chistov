# =====================================================================
#  Фрагмент конфигурации ядра: требования syzkaller
#  (docs/linux/kernel_configs.md, syzbot reference config)
#  Применяется поверх defconfig + kvm_guest.config
# =====================================================================

# --- Сбор покрытия (KCOV) --------------------------------------------
CONFIG_KCOV=y
CONFIG_KCOV_INSTRUMENT_ALL=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_DEBUG_FS=y

# --- Символизация стеков и отчётов -----------------------------------
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
# CONFIG_RANDOMIZE_BASE is not set

# --- Определение детекторов памяти -----------------------------------
CONFIG_KASAN=y
CONFIG_KASAN_INLINE=y

# --- Песочница/пространства имён и cgroups ---------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y

# --- Образ rootfs (debugfs/configfs нужны syzkaller) ------------------
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y

# --- Инъекция отказов (нужна syzkaller для поиска ошибок) -------------
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAULT_INJECTION_USERCOPY=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAIL_MAKE_REQUEST=y
CONFIG_FAIL_IO_TIMEOUT=y
CONFIG_FAIL_FUTEX=y

# --- Прочее, что ожидает syz-manager ---------------------------------
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_ELF=y
CONFIG_SYSVIPC=y
CONFIG_NET_DEVLINK=y
