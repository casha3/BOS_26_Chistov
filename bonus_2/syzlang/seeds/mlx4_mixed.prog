# Смешанный сценарий: ethtool, MTU, флаги и txqueuelen в одной программе
r0 = socket$inet(0x2, 0x2, 0x0)
ioctl$sock_SIOCETHTOOL_mlx4(r0, 0x8946, &AUTO)
ioctl$sock_SIOCSIFMTU_mlx4(r0, 0x8922, &AUTO)
ioctl$sock_SIOCSIFTXQLEN_mlx4(r0, 0x8943, &AUTO)
ioctl$sock_SIOCSIFFLAGS_mlx4(r0, 0x8914, &AUTO)
ioctl$sock_SIOCETHTOOL_mlx4(r0, 0x8946, &AUTO)
close(r0)
